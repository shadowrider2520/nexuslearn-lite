# Supabase — project URL and anon key from Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Groq — API key from https://console.groq.com (used by the AI tutor, roadmap and task generators)
GROQ_API_KEY=

# Optional: override the Groq model used by the AI (defaults to openai/gpt-oss-120b)
# GROQ_MODEL=openai/gpt-oss-120b
